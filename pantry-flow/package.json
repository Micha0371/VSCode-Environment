{
  "name": "pantry-flow",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:legacy": "node --test tests/*.test.cjs",
    "test:components": "jest --runInBand",
    "test:safety": "tsx --test tests/integration/local-stack.test.ts",
    "test:fast": "npm run typecheck && npm run test:legacy && npm run test:components && npm run test:safety",
    "db:start": "supabase start -x realtime,storage-api,imgproxy,edge-runtime,studio,logflare,vector,supavisor",
    "db:reset": "supabase db reset --local",
    "test:db": "supabase test db",
    "test:integration": "tsx --test tests/integration/behavior.integration.ts",
    "test:local": "npm run db:reset && npm run test:db && npm run test:integration",
    "e2e:prepare": "tsx scripts/e2e-fixtures.ts prepare",
    "e2e:verify": "tsx scripts/e2e-fixtures.ts verify",
    "e2e:cleanup": "tsx scripts/e2e-fixtures.ts cleanup",
    "e2e:build": "node scripts/build-e2e.cjs",
    "test:e2e": "node scripts/run-e2e.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-linking": "~7.0.3",
    "expo-router": "~4.0.9",
    "expo-status-bar": "~2.0.0",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@testing-library/react-native": "12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "@types/react-test-renderer": "^18.3.0",
    "jest": "29.7.0",
    "jest-expo": "~52.0.0",
    "react-test-renderer": "18.3.1",
    "supabase": "2.58.5",
    "tsx": "4.20.6",
    "typescript": "^5.3.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
