{
  "name": "pantry-flow",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:legacy": "node --test tests/*.test.cjs",
    "test:components": "jest --runInBand",
    "test:safety": "tsx --test tests/integration/local-stack.test.ts",
    "test:fast": "npm run typecheck && npm run test:legacy && npm run test:components && npm run test:safety",
    "db:start": "supabase start -x realtime,storage-api,imgproxy,edge-runtime,studio,logflare,vector,supavisor",
    "db:reset": "supabase db reset --local",
    "test:db": "supabase test db",
    "test:integration": "tsx --test tests/integration/behavior.integration.ts",
    "test:local": "npm run db:reset && npm run test:db && npm run test:integration",
    "e2e:prepare": "tsx scripts/e2e-fixtures.ts prepare",
    "e2e:verify": "tsx scripts/e2e-fixtures.ts verify",
    "e2e:cleanup": "tsx scripts/e2e-fixtures.ts cleanup",
    "e2e:build": "node scripts/build-e2e.cjs",
    "test:e2e": "node scripts/run-e2e.cjs",
    "postinstall": "node scripts/patch-expo-windows.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.0.0",
    "babel-preset-expo": "~58.0.24",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react-dom": "19.3.0",
    "react-test-renderer": "19.3.0",
    "supabase": "2.58.5",
    "test-renderer": "~1.3.1",
    "tsx": "4.20.6",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "overrides": {
    "supabase": {
      "tar": "7.5.22"
    }
  }
}
